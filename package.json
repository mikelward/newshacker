{
  "name": "newshacker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "react-compiler:check": "react-compiler-healthcheck",
    "typecheck": "tsc -b --noEmit",
    "icons:generate": "node scripts/generate-icons.mjs",
    "analyze:telemetry": "node --env-file-if-exists=.env.local scripts/analyze-summary-layout.mjs"
  },
  "engines": {
    "node": "^24.12.0",
    "npm": ">=11.10.0"
  },
  "overrides": {
    "glob": "^13.0.6"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@google/genai": "^2.32.0",
    "@tanstack/query-async-storage-persister": "^5.105.1",
    "@tanstack/query-sync-storage-persister": "^5.105.1",
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-query-persist-client": "^5.105.1",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "^2.0.1",
    "node-html-parser": "^9.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "happy-dom": "^20.14.6",
    "minimatch": "^10.2.6",
    "msw": "^2.15.0",
    "react-compiler-healthcheck": "^1.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
